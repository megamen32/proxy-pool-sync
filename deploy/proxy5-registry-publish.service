[Unit]
Description=Раскладка пула proxy5 в приватные каталоги потребителей
Documentation=file:///home/roomhacker/PycharmProjects/proxy-pool-sync/src/proxy_pool_sync/proxy5/README.md
After=proxy5-registry-sync.service
Requires=proxy5-registry-sync.service

[Service]
Type=oneshot
# root: каталог ATV-состояния закрыт 0700, и туда кладёт файл только root.
# Источник истины — /var/lib/proxy5-registry/pool.txt (его пишет sync от roomhacker).
User=root
Environment=POOL_SOURCE=/var/lib/proxy5-registry/pool.txt
Environment=ATV_POOL_FILE=/var/lib/telegramauto-ha/atv-state-v2/scrape_fleet/proxies.txt
ExecStart=/usr/bin/install -m 0644 -o root -g root ${POOL_SOURCE} ${ATV_POOL_FILE}
MemoryHigh=32M
MemoryMax=64M
MemorySwapMax=0
CPUQuota=10%
TasksMax=8
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/telegramauto-ha/atv-state-v2/scrape_fleet
PrivateTmp=true
