[Unit]
Description=HTTP-выдача пула proxy5 (только loopback)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=roomhacker
WorkingDirectory=/home/roomhacker/PycharmProjects/proxy-pool-sync
Environment=PYTHONPATH=/home/roomhacker/PycharmProjects/proxy-pool-sync/src
Environment=PROXY5_INVENTORY_DB=/var/lib/proxy5-registry/inventory.db
Environment=PROXY5_POOL_SNAPSHOT=/var/lib/proxy5-registry/pool.txt
Environment=PROXY5_SERVE_PORT=18102
ExecStart=/opt/proxy-pool-sync/bin/python -m proxy_pool_sync.proxy5.serve
Restart=on-failure
RestartSec=5s
MemoryHigh=64M
MemoryMax=96M
MemorySwapMax=0
CPUQuota=20%
TasksMax=16
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/proxy5-registry
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
